# Kopieren nach infra/.env und anpassen. infra/.env ist gitignored.

# Lokale Postgres (Podman)
POSTGRES_DB=mylineup
POSTGRES_USER=mylineup
POSTGRES_PASSWORD=mylineup

# Quarkus API
JWT_ISSUER=https://mylineup.local
CORS_ORIGINS=/http://localhost:.*/

# React-Apps (zur Build-Zeit eingebrannt)
VITE_API_URL=http://localhost:8081
VITE_USER_APP_URL=http://localhost:8083
